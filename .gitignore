# Repositories nicht im GIT ablegen
repositories/*
!repositories/.gitkeep

# Firewall-Staging (heruntergeladene Configs, temporaer)
tmp/firewalls/*
!tmp/firewalls/.gitkeep

# Samba-Staging (rsync-Spiegel der Freigaben, temporaer) + Lockfile
tmp/samba/*
!tmp/samba/.gitkeep
tmp/samba-backup.lock

# Konfigurationsdateien mit echten Zugangsdaten – niemals ins Repo!
*.cfg
*.env

# Aber Beispieldateien sind erlaubt
!*.cfg.example
!*.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Logs
*.log

# Temporaere Dateien
*.tmp
.DS_Store