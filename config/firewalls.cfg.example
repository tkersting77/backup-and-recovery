# /config/firewalls.cfg
# Konfiguration fuer opnsense_backup.py
# Diese Datei bleibt auf dem Server – NICHT ins Git-Repo committen!
# firewalls.cfg.example dient als Vorlage und IST im Git-Repo.

# Restic Repository
RESTIC_REPO=/backup/files/restic/firewalls
RESTIC_PASSWORD_FILE=/etc/restic/firewalls.pwd

# Firewalls: Name -> Zugangsdaten
# Format: FRW_<NAME>_IP, FRW_<NAME>_KEY, FRW_<NAME>_SECRET
# Namen werden automatisch aus den FRW_*_IP Eintraegen ermittelt –
# einfach weitere Bloecke hinzufuegen fuer neue Firewalls.
FRW_01_IP=10.0.1.1
FRW_01_KEY=api-key-hier
FRW_01_SECRET=api-secret-hier

FRW_02_IP=10.0.2.1
FRW_02_KEY=api-key-hier
FRW_02_SECRET=api-secret-hier

FRW_03_IP=10.0.3.1
FRW_03_KEY=api-key-hier
FRW_03_SECRET=api-secret-hier

# Restic Labels
RESTIC_HOST_LABEL=firma-opnsense
RESTIC_TAG=opnsense

# Logging
LOG_FILE=/var/log/opnsense-backup.log

# Mail-Benachrichtigung
NOTIFY_MAIL_TO=admin@firma.de
NOTIFY_MAIL_FROM=backup@firma.de
SMTP_HOST=localhost

# Retention Policy
# Nach jedem erfolgreichen Backup per "restic forget --prune" angewendet.
# Restic behaelt pro Zeit-Bucket jeweils den neuesten Snapshot, alles andere
# wird geloescht:
#   KEEP_DAILY=7    -> von den letzten 7 Tagen je 1 Snapshot/Tag
#   KEEP_WEEKLY=4   -> danach von den letzten 4 Wochen je 1 Snapshot/Woche
#   KEEP_MONTHLY=12 -> danach von den letzten 12 Monaten je 1 Snapshot/Monat
#   KEEP_YEARLY=2   -> danach von den letzten 2 Jahren je 1 Snapshot/Jahr
# Die Buckets ueberlappen sich nicht (kein Snapshot zaehlt doppelt), gelten
# nur fuer Snapshots mit RESTIC_TAG dieser Datei.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
KEEP_YEARLY=2
