[Unit]
Description=Restic WebUI
After=network.target

[Service]
Type=simple
Environment=HOME=/root
ExecStart=/backup/files/backup-and-recovery/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
WorkingDirectory=/backup/files/backup-and-recovery/webui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
